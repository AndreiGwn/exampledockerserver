<mxfile host="app.diagrams.net" modified="2026-09-17T10:30:00.000Z" agent="Mozilla/5.0" version="21.0.0" type="device">
  <diagram id="mvcr-architecture" name="MVCR Architecture & Class Diagram">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ================= ROUTES SECTION ================= -->
        <mxCell id="grp-routes" value="ROUTES (routes/web.php &amp; routes/auth.php)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#475569;startSize=30;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="460" height="420" as="geometry" />
        </mxCell>
        <mxCell id="route-1" value="GET  /  -&gt; HotelController@index [hotels.index]&#xa;GET  /hotels/{id} -&gt; HotelController@show [hotels.show]&#xa;GET  /dashboard  -&gt; Closure Dashboard [dashboard]&#xa;GET  /owner/hotels -&gt; OwnerHotelController@index [owner.hotels.index]&#xa;GET  /owner/hotels/create -&gt; OwnerHotelController@create [owner.hotels.create]&#xa;POST /owner/hotels -&gt; OwnerHotelController@store [owner.hotels.store]&#xa;GET  /owner/hotels/{id}/edit -&gt; OwnerHotelController@edit [owner.hotels.edit]&#xa;PUT  /owner/hotels/{id} -&gt; OwnerHotelController@update [owner.hotels.update]&#xa;DEL  /owner/hotels/{id} -&gt; OwnerHotelController@destroy [owner.hotels.destroy]&#xa;GET  /owner/hotels/{hotelId}/rooms -&gt; OwnerRoomController@index [owner.rooms.index]&#xa;GET  /owner/hotels/{hotelId}/rooms/create -&gt; OwnerRoomController@create&#xa;POST /owner/hotels/{hotelId}/rooms -&gt; OwnerRoomController@store&#xa;GET  /owner/hotels/{hotelId}/rooms/{id}/edit -&gt; OwnerRoomController@edit&#xa;PUT  /owner/hotels/{hotelId}/rooms/{id} -&gt; OwnerRoomController@update&#xa;DEL  /owner/hotels/{hotelId}/rooms/{id} -&gt; OwnerRoomController@destroy&#xa;GET  /register -&gt; RegisteredUserController@create&#xa;POST /register -&gt; RegisteredUserController@store&#xa;GET  /login -&gt; AuthenticatedSessionController@create&#xa;POST /login -&gt; AuthenticatedSessionController@store" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Courier New;" vertex="1" parent="grp-routes">
          <mxGeometry x="15" y="40" width="430" height="360" as="geometry" />
        </mxCell>

        <!-- ================= CONTROLLERS SECTION ================= -->
        <mxCell id="grp-controllers" value="CONTROLLERS (app/Http/Controllers/)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;startSize=30;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="40" width="560" height="680" as="geometry" />
        </mxCell>

        <!-- HotelController Class -->
        <mxCell id="c-hotel" value="&lt;b&gt;HotelController&lt;/b&gt;&#xa;--&#xa;+ __construct(Hotel $hotelModel, Room $roomModel)&#xa;+ index(Request $request): View&#xa;+ show(int $id): View" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;align=left;spacingLeft=10;" vertex="1" parent="grp-controllers">
          <mxGeometry x="20" y="45" width="520" height="95" as="geometry" />
        </mxCell>

        <!-- OwnerHotelController Class -->
        <mxCell id="c-owner-hotel" value="&lt;b&gt;OwnerHotelController&lt;/b&gt;&#xa;--&#xa;+ __construct(Hotel $hotelModel, Room $roomModel)&#xa;+ index(): View&#xa;+ create(): View&#xa;+ store(Request $request): RedirectResponse&#xa;+ edit(int $id): View|RedirectResponse&#xa;+ update(Request $request, int $id): RedirectResponse&#xa;+ destroy(int $id): RedirectResponse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;align=left;spacingLeft=10;" vertex="1" parent="grp-controllers">
          <mxGeometry x="20" y="155" width="520" height="175" as="geometry" />
        </mxCell>

        <!-- OwnerRoomController Class -->
        <mxCell id="c-owner-room" value="&lt;b&gt;OwnerRoomController&lt;/b&gt;&#xa;--&#xa;+ __construct(Room $roomModel, Hotel $hotelModel)&#xa;+ index(int $hotelId): View|RedirectResponse&#xa;+ create(int $hotelId): View&#xa;+ store(Request $request, int $hotelId): RedirectResponse&#xa;+ edit(int $hotelId, int $roomId): View|RedirectResponse&#xa;+ update(Request $request, int $hotelId, int $roomId): RedirectResponse&#xa;+ destroy(int $hotelId, int $roomId): RedirectResponse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;align=left;spacingLeft=10;" vertex="1" parent="grp-controllers">
          <mxGeometry x="20" y="345" width="520" height="175" as="geometry" />
        </mxCell>

        <!-- RegisteredUserController Class -->
        <mxCell id="c-auth" value="&lt;b&gt;RegisteredUserController&lt;/b&gt;&#xa;--&#xa;+ create(): View&#xa;+ store(Request $request): RedirectResponse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;align=left;spacingLeft=10;" vertex="1" parent="grp-controllers">
          <mxGeometry x="20" y="535" width="520" height="85" as="geometry" />
        </mxCell>

        <!-- ================= MODELS (STORED PROCEDURE WRAPPERS) ================= -->
        <mxCell id="grp-models" value="MODELS / SP WRAPPERS (app/Models/)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;startSize=30;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1140" y="40" width="540" height="680" as="geometry" />
        </mxCell>

        <!-- Hotel Model -->
        <mxCell id="m-hotel" value="&lt;b&gt;Hotel&lt;/b&gt; (Wrapper for Stored Procedures)&#xa;--&#xa;+ getAll(): array  &lt;i&gt;-- calls SP_Hotel_ReadAll&lt;/i&gt;&#xa;+ findById(int $id): object  &lt;i&gt;-- calls SP_Hotel_Read&lt;/i&gt;&#xa;+ getByOwnerId(int $userId): array  &lt;i&gt;-- calls SP_Hotel_ReadByOwner&lt;/i&gt;&#xa;+ createHotel(array $data): int  &lt;i&gt;-- calls SP_Hotel_Create&lt;/i&gt;&#xa;+ updateHotel(int $id, array $data, ?int $userId): bool  &lt;i&gt;-- calls SP_Hotel_Update&lt;/i&gt;&#xa;+ deleteHotel(int $id, ?int $userId): bool  &lt;i&gt;-- calls SP_Hotel_Delete&lt;/i&gt;&#xa;+ search(array $filters): array  &lt;i&gt;-- calls SP_Hotel_Search&lt;/i&gt;&#xa;+ getDistinctCities(): array" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#10b981;align=left;spacingLeft=10;" vertex="1" parent="grp-models">
          <mxGeometry x="20" y="45" width="500" height="210" as="geometry" />
        </mxCell>

        <!-- Room Model -->
        <mxCell id="m-room" value="&lt;b&gt;Room&lt;/b&gt; (Wrapper for Stored Procedures)&#xa;--&#xa;+ getByHotelId(int $hotelId): array  &lt;i&gt;-- calls SP_Room_ReadByHotel&lt;/i&gt;&#xa;+ createRoom(array $data): int  &lt;i&gt;-- calls SP_Room_Create&lt;/i&gt;&#xa;+ updateRoom(int $id, array $data): bool  &lt;i&gt;-- calls SP_Room_Update&lt;/i&gt;&#xa;+ deleteRoom(int $id): bool  &lt;i&gt;-- calls SP_Room_Delete&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#10b981;align=left;spacingLeft=10;" vertex="1" parent="grp-models">
          <mxGeometry x="20" y="275" width="500" height="155" as="geometry" />
        </mxCell>

        <!-- User Model -->
        <mxCell id="m-user" value="&lt;b&gt;User&lt;/b&gt; (Authenticatable Eigenaar)&#xa;--&#xa;+ id: int&#xa;+ name: string&#xa;+ email: string&#xa;+ role: string ('eigenaar')&#xa;+ phone: string&#xa;+ company_name: string&#xa;+ isEigenaar(): bool&#xa;+ hotels(): HasMany" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#10b981;align=left;spacingLeft=10;" vertex="1" parent="grp-models">
          <mxGeometry x="20" y="450" width="500" height="180" as="geometry" />
        </mxCell>

        <!-- ================= VIEWS SECTION ================= -->
        <mxCell id="grp-views" value="VIEWS (resources/views/)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fdf4ff;strokeColor=#c026d3;startSize=30;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="490" width="460" height="380" as="geometry" />
        </mxCell>
        <mxCell id="v-list" value="• &lt;b&gt;welcome.blade.php&lt;/b&gt;: Public Trivago search, destination selector, hotel cards.&#xa;• &lt;b&gt;hotels/show.blade.php&lt;/b&gt;: Single hotel details, amenities, room types list.&#xa;• &lt;b&gt;dashboard.blade.php&lt;/b&gt;: Eigenaar control center with stats &amp; quick links.&#xa;• &lt;b&gt;owner/hotels/index.blade.php&lt;/b&gt;: Table of owned hotels with CRUD actions.&#xa;• &lt;b&gt;owner/hotels/create.blade.php&lt;/b&gt;: Add hotel form.&#xa;• &lt;b&gt;owner/hotels/edit.blade.php&lt;/b&gt;: Edit hotel details form.&#xa;• &lt;b&gt;owner/rooms/index.blade.php&lt;/b&gt;: Hotel room list &amp; availability toggles.&#xa;• &lt;b&gt;owner/rooms/create.blade.php&lt;/b&gt;: Add room to hotel.&#xa;• &lt;b&gt;owner/rooms/edit.blade.php&lt;/b&gt;: Edit room parameters &amp; pricing.&#xa;• &lt;b&gt;auth/register.blade.php&lt;/b&gt;: Eigenaar registration form." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="grp-views">
          <mxGeometry x="15" y="40" width="430" height="320" as="geometry" />
        </mxCell>

        <!-- Connectors -->
        <mxCell id="edge1" value="routes to" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;strokeColor=#3b82f6;strokeWidth=2;" edge="1" parent="1" source="grp-routes" target="grp-controllers">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge2" value="IoC injected into" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#10b981;strokeWidth=2;" edge="1" parent="1" source="grp-models" target="grp-controllers">
          <mxGeometry relative="1" as="geometry" />
