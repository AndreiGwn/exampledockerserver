        <mxCell id="edge3" value="renders" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#c026d3;strokeWidth=2;" edge="1" parent="1" source="grp-controllers" target="grp-views">
