  <diagram id="erd-database" name="Entity Relationship Diagram (ERD)">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TABLE: USERS -->
        <mxCell id="t-users" value="&lt;b&gt;USERS&lt;/b&gt;&#xa;--&#xa;&lt;b&gt;PK&lt;/b&gt; id: BIGINT UNSIGNED [REQ]&#xa;name: VARCHAR(255) [REQ]&#xa;email: VARCHAR(255) [REQ, UNIQUE]&#xa;password: VARCHAR(255) [REQ]&#xa;role: VARCHAR(50) [REQ, DEFAULT 'eigenaar']&#xa;phone: VARCHAR(50) [OPT / NULLABLE]&#xa;company_name: VARCHAR(255) [OPT / NULLABLE]&#xa;email_verified_at: TIMESTAMP [OPT / NULLABLE]&#xa;remember_token: VARCHAR(100) [OPT / NULLABLE]&#xa;created_at: TIMESTAMP [OPT / NULLABLE]&#xa;updated_at: TIMESTAMP [OPT / NULLABLE]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#475569;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="300" height="230" as="geometry" />
        </mxCell>

        <!-- TABLE: HOTELS -->
        <mxCell id="t-hotels" value="&lt;b&gt;HOTELS&lt;/b&gt;&#xa;--&#xa;&lt;b&gt;PK&lt;/b&gt; id: BIGINT UNSIGNED [REQ]&#xa;&lt;b&gt;FK&lt;/b&gt; user_id: BIGINT UNSIGNED [REQ]&#xa;name: VARCHAR(255) [REQ]&#xa;description: TEXT [REQ]&#xa;city: VARCHAR(100) [REQ]&#xa;address: VARCHAR(255) [REQ]&#xa;star_rating: INT [REQ, DEFAULT 3]&#xa;price_per_night: DECIMAL(10,2) [REQ, DEFAULT 0.00]&#xa;image_url: VARCHAR(500) [OPT / NULLABLE]&#xa;phone: VARCHAR(50) [OPT / NULLABLE]&#xa;email: VARCHAR(255) [OPT / NULLABLE]&#xa;is_featured: TINYINT(1) [REQ, DEFAULT 0]&#xa;created_at: TIMESTAMP [OPT / NULLABLE]&#xa;updated_at: TIMESTAMP [OPT / NULLABLE]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="460" y="80" width="320" height="290" as="geometry" />
        </mxCell>

        <!-- TABLE: ROOMS -->
        <mxCell id="t-rooms" value="&lt;b&gt;ROOMS&lt;/b&gt;&#xa;--&#xa;&lt;b&gt;PK&lt;/b&gt; id: BIGINT UNSIGNED [REQ]&#xa;&lt;b&gt;FK&lt;/b&gt; hotel_id: BIGINT UNSIGNED [REQ]&#xa;name: VARCHAR(255) [REQ]&#xa;room_type: VARCHAR(100) [REQ]&#xa;price_per_night: DECIMAL(10,2) [REQ]&#xa;capacity: INT [REQ, DEFAULT 2]&#xa;beds: VARCHAR(100) [REQ]&#xa;description: TEXT [OPT / NULLABLE]&#xa;image_url: VARCHAR(500) [OPT / NULLABLE]&#xa;is_available: TINYINT(1) [REQ, DEFAULT 1]&#xa;created_at: TIMESTAMP [OPT / NULLABLE]&#xa;updated_at: TIMESTAMP [OPT / NULLABLE]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="880" y="80" width="300" height="260" as="geometry" />
        </mxCell>

        <!-- TABLE: AMENITIES -->
        <mxCell id="t-amenities" value="&lt;b&gt;AMENITIES&lt;/b&gt;&#xa;--&#xa;&lt;b&gt;PK&lt;/b&gt; id: BIGINT UNSIGNED [REQ]&#xa;name: VARCHAR(100) [REQ, UNIQUE]&#xa;icon: VARCHAR(100) [REQ, DEFAULT 'check-circle']&#xa;created_at: TIMESTAMP [OPT / NULLABLE]&#xa;updated_at: TIMESTAMP [OPT / NULLABLE]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf4ff;strokeColor=#c026d3;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="460" y="470" width="320" height="150" as="geometry" />
        </mxCell>

        <!-- TABLE: HOTEL_AMENITIES (Pivot) -->
        <mxCell id="t-ha" value="&lt;b&gt;HOTEL_AMENITIES&lt;/b&gt;&#xa;--&#xa;&lt;b&gt;PK, FK&lt;/b&gt; hotel_id: BIGINT UNSIGNED [REQ]&#xa;&lt;b&gt;PK, FK&lt;/b&gt; amenity_id: BIGINT UNSIGNED [REQ]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="880" y="470" width="300" height="100" as="geometry" />
        </mxCell>

        <!-- TABLE: REVIEWS -->
        <mxCell id="t-reviews" value="&lt;b&gt;REVIEWS&lt;/b&gt;&#xa;--&#xa;&lt;b&gt;PK&lt;/b&gt; id: BIGINT UNSIGNED [REQ]&#xa;&lt;b&gt;FK&lt;/b&gt; hotel_id: BIGINT UNSIGNED [REQ]&#xa;reviewer_name: VARCHAR(255) [REQ]&#xa;rating: DECIMAL(3,1) [REQ, DEFAULT 8.0]&#xa;comment: TEXT [REQ]&#xa;created_at: TIMESTAMP [OPT / NULLABLE]&#xa;updated_at: TIMESTAMP [OPT / NULLABLE]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="430" width="300" height="180" as="geometry" />
        </mxCell>

        <!-- RELATIONSHIPS -->
        <!-- Users (1) -> (N) Hotels -->
        <mxCell id="rel-u-h" value="1 : N&#xa;(owns)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#475569;" edge="1" parent="1" source="t-users" target="t-hotels">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Hotels (1) -> (N) Rooms -->
        <mxCell id="rel-h-r" value="1 : N&#xa;(contains)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#3b82f6;" edge="1" parent="1" source="t-hotels" target="t-rooms">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Hotels (1) -> (N) Reviews -->
        <mxCell id="rel-h-rev" value="1 : N&#xa;(receives)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#ef4444;" edge="1" parent="1" source="t-hotels" target="t-reviews">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Hotels (N) -> (M) Amenities via HOTEL_AMENITIES -->
        <mxCell id="rel-h-ha" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#ea580c;" edge="1" parent="1" source="t-hotels" target="t-ha">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rel-a-ha" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#ea580c;" edge="1" parent="1" source="t-amenities" target="t-ha">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

